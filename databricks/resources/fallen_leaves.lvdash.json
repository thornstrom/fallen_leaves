{
  "datasets": [
    {
      "name": "ds_national",
      "displayName": "Per dag och region",
      "queryLines": [
        "SELECT event_date, region, n_stations, n_arrivals, avg_arrival_delay_min, share_delayed_5, n_canceled, temp_mean_c, temp_min_c, temp_delta_c, precip_mm, share_arrivals_frost FROM daily_national"
      ]
    },
    {
      "name": "ds_stations",
      "displayName": "Per station",
      "queryLines": [
        "SELECT location_id, station_name, region, latitude, longitude, SUM(n_arrivals) AS n_arrivals, ROUND(SUM(delay_sum_min) / NULLIF(SUM(n_arrivals), 0), 2) AS avg_arrival_delay_min, ROUND(SUM(n_delayed_5) / NULLIF(SUM(n_arrivals), 0), 3) AS share_delayed_5, SUM(n_canceled) AS n_canceled, ROUND(AVG(temp_mean_c), 1) AS temp_mean_c FROM daily_station_delay_weather WHERE latitude IS NOT NULL GROUP BY location_id, station_name, region, latitude, longitude"
      ]
    },
    {
      "name": "ds_corr",
      "displayName": "Korrelationer",
      "queryLines": [
        "SELECT region, delay_metric, weather_metric, lag_days, n, ROUND(pearson_r, 3) AS pearson_r, ROUND(spearman_rho, 3) AS spearman_rho, ROUND(p_value_pearson, 4) AS p_value_pearson, CASE WHEN p_value_pearson < 0.05 THEN 'Ja' ELSE 'Nej' END AS signifikant, date_from, date_to FROM correlation_results"
      ]
    }
  ],
