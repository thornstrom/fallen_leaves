// Mått för rapporten "Fallande löv". Lägg dem i tabellen daily_national
// (Modellering → Nytt mått) eller i en separat måtttabell.

Ankomster =
SUM ( daily_national[n_arrivals] )

Medelförsening (min) =
DIVIDE (
    SUMX ( daily_national, daily_national[avg_arrival_delay_min] * daily_national[n_arrivals] ),
    [Ankomster]
)

Andel > 5 min sena =
DIVIDE (
    SUMX ( daily_national, daily_national[share_delayed_5] * daily_national[n_arrivals] ),
    [Ankomster]
)

Medeltemperatur (°C) =
DIVIDE (
    SUMX (
        FILTER ( daily_national, NOT ISBLANK ( daily_national[temp_mean_c] ) ),
        daily_national[temp_mean_c] * daily_national[n_arrivals]
    ),
    SUMX (
        FILTER ( daily_national, NOT ISBLANK ( daily_national[temp_mean_c] ) ),
        daily_national[n_arrivals]
    )
)

Inställda =
SUM ( daily_national[n_canceled] )

// För korrelationstabellen: visar bara resultat med tillräckligt underlag.
Signifikant (p < 0,05) =
IF (
    SELECTEDVALUE ( correlation_results[p_value_pearson] ) < 0.05,
    "Ja",
    "Nej"
)
